<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="32dp"
    app:cardElevation="12dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="选择月份"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center" />

        <!-- 年份切换 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_picker_prev_year"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="上一年"
                android:src="@drawable/ic_arrow_left" />

            <TextView
                android:id="@+id/tv_picker_year"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="2026年"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_picker_next_year"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="下一年"
                android:src="@drawable/ic_arrow_right" />
        </LinearLayout>

        <!-- 12 个月，3 行 × 4 列 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_picker_month_1"
                style="@style/MonthPickerCell"
                android:text="1月" />

            <TextView
                android:id="@+id/tv_picker_month_2"
                style="@style/MonthPickerCell"
                android:text="2月" />

            <TextView
                android:id="@+id/tv_picker_month_3"
                style="@style/MonthPickerCell"
                android:text="3月" />

            <TextView
                android:id="@+id/tv_picker_month_4"
                style="@style/MonthPickerCell"
                android:text="4月" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_picker_month_5"
                style="@style/MonthPickerCell"
                android:text="5月" />

            <TextView
                android:id="@+id/tv_picker_month_6"
                style="@style/MonthPickerCell"
                android:text="6月" />

            <TextView
                android:id="@+id/tv_picker_month_7"
                style="@style/MonthPickerCell"
                android:text="7月" />

            <TextView
                android:id="@+id/tv_picker_month_8"
                style="@style/MonthPickerCell"
                android:text="8月" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_picker_month_9"
                style="@style/MonthPickerCell"
                android:text="9月" />

            <TextView
                android:id="@+id/tv_picker_month_10"
                style="@style/MonthPickerCell"
                android:text="10月" />

            <TextView
                android:id="@+id/tv_picker_month_11"
                style="@style/MonthPickerCell"
                android:text="11月" />

            <TextView
                android:id="@+id/tv_picker_month_12"
                style="@style/MonthPickerCell"
                android:text="12月" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_picker_cancel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_field"
            android:text="取消"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
