<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="32dp"
    app:cardElevation="12dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_complete_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="选择支出流水"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_complete_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="勾选本月已支出的流水，金额将自动合计"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:gravity="center" />

        <ScrollView
            android:id="@+id/sv_complete_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxHeight="280dp"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/ll_transaction_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/tv_complete_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="本月没有可用于关联的支出流水"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_complete_total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="已选 0 笔 · ¥0.00"
            android:textColor="@color/app_blue"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_cancel_complete"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="取 消"
                android:textColor="@color/text_primary"
                android:backgroundTint="@color/input_bg"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/btn_confirm_complete"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="完 成"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:backgroundTint="@color/app_blue"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
